# AI Cost Tracking Configuration
# Get your API key from: https://openrouter.ai/keys

# OpenRouter API Key (required for real cost calculation)
OPENROUTER_API_KEY=sk-or-v1-...

# Default AI model for cost analysis
LLM_MODEL=openrouter/qwen/qwen3-coder-next

# Optional: SaaS token for managed billing
# SAAS_TOKEN=your-saas-token

# ---------------------------------------------------------------------------
# vdisplay automation / options (comma-separated lists, key=value dicts)
# Precedence: vdisplay.yaml > .env > built-in fallbacks
# ---------------------------------------------------------------------------

# Agent + observe
VDISPLAY_AGENT_URL=http://127.0.0.1:8765
VDISPLAY_AGENT_HOST=127.0.0.1
VDISPLAY_AGENT_PORT=8765
VDISPLAY_AGENT_AUTO=1
VDISPLAY_AGENT_AUDIT_DELEGATE=1
VDISPLAY_OBSERVE=1
VDISPLAY_VQL=1
VDISPLAY_IMGL=1
VDISPLAY_IMGL_LANG=eng+pol

# Automation defaults (yaml ``automation:`` overrides these)
VDISPLAY_AUTOMATION_OBSERVE=true
VDISPLAY_AUTOMATION_OBSERVE_ON_SCREENSHOT=true
VDISPLAY_AUTOMATION_VERIFY_STRICT=true
VDISPLAY_AUTOMATION_REJECT_VISION_STUBS=true
VDISPLAY_AUTOMATION_SESSION=true
VDISPLAY_AUTOMATION_POST_ACT_VERIFY=true
VDISPLAY_METADATA_DIR=.vdisplay
VDISPLAY_DEFAULT_MONITOR=DP-1
VDISPLAY_DEFAULT_MAP=
VDISPLAY_PLANFILE=examples/dev-workflow/planfile.yaml

# Option catalogs (yaml ``options:`` overrides these)
VDISPLAY_CONTROL_BACKENDS=auto,atspi,x11,browser,terminal,vision
VDISPLAY_CONTROL_ENVIRONMENTS=desktop,browser,terminal,vision
VDISPLAY_VISION_ANCHOR_RELATIONS=right_of,below,near,left_of,above
VDISPLAY_AUTO_SOURCES=auto,yaml,tickets
VDISPLAY_RUNNABLE_TASK_STATUSES=todo,open,ready,pending,
VDISPLAY_TASK_PRIORITIES=critical=0,high=1,normal=2,medium=3,low=4
VDISPLAY_PLANFILE_TASK_KEYS=automation,automation_tasks,control_tasks,desktop_tasks,tasks
VDISPLAY_CONTROL_ACTUATION_MARKERS=control click,control focus,control set-value,control find,control list,ide prompt,CONTROL_CLICK,CONTROL_FOCUS,CONTROL_SET_VALUE,CONTROLS_FIND,CONTROLS_LIST
VDISPLAY_VISION_INJECTION_COMMANDS=control find,control focus,control click,control set-value,controls_find
VDISPLAY_ACTION_MAP_TEMPLATES=maps/{app}-chat.json,maps/{id}.json,maps/{id_dash}.json
VDISPLAY_METADATA_SUBDIRS=runs,observe,vql,context,config
VDISPLAY_OBSERVE_SIDECAR_SUFFIXES=.context.json,.vql.json,.vql.svg
VDISPLAY_IDE_APPS=cursor,jetbrains,pycharm,vscode,idea

# VQL decide/act limits
VDISPLAY_VQL_TARGET_LIMIT=32
VDISPLAY_VQL_LAYER_EXPORT_LIMIT=128
VDISPLAY_VQL_MAP_TARGET_LIMIT=32
VDISPLAY_VQL_OCR_TEXT_MAX_LEN=48
VDISPLAY_VQL_KIND_PRIORITY=input=0,button=1,window=2,element=3,ocr=4,panel=5

# CLI format catalogs (yaml ``options:`` overrides these)
VDISPLAY_CONTROL_LIST_FORMATS=flat,tree
VDISPLAY_OBSERVE_OUTPUT_FORMATS=json,vql,summary
VDISPLAY_SAMPLER_CAPTURE_MODES=desktop,strict,unattended,best-effort
VDISPLAY_SAMPLER_FRAME_FORMATS=png,webp,jpeg
VDISPLAY_DIAGNOSE_MODES=control,unattended
VDISPLAY_BROWSER_VENDORS=chromium,firefox
VDISPLAY_SESSION_EXPORT_FORMATS=readme,json,summary
VDISPLAY_SCREENSHOT_SOURCES=host,mirror,virtual,relay

# Control retry / timing / vision runtime
VDISPLAY_CONTROL_RETRY=auto
VDISPLAY_CONTROL_MAX_ATTEMPTS=3
VDISPLAY_CONTROL_RETRY_DELAY_MS=150
VDISPLAY_CONTROL_RETRY_STRATEGIES=retry_scope,fallback_backend,refresh_map
VDISPLAY_CONTROL_FOCUS_MS=350
VDISPLAY_CONTROL_POINTER_SETTLE_MS=50
VDISPLAY_CONTROL_SETTLE_MS=150
VDISPLAY_VISION_BACKEND=auto
VDISPLAY_OCR_CACHE=1
VDISPLAY_ATSPI_TIMEOUT_S=30
VDISPLAY_IDE_FIND_TIMEOUT_S=20
VDISPLAY_BROWSER_DETACHED=1
VDISPLAY_VISION_LLM_MODE=off
VDISPLAY_VISION_LLM_MODALITIES=image,text
VDISPLAY_VISION_LLM_TIMEOUT_S=30
VDISPLAY_OBSERVE_CACHE=1
VDISPLAY_IMGL_SKIP_BLANK=0
VDISPLAY_SESSION_BASE=.vdisplay

# Koru + vdisplay photo VQL (when driving from koru repo / wrapper scripts)
# KORU_VDISPLAY_SOURCE=DP-1
# KORU_VDISPLAY_VQL_PATH=.vdisplay/koru-cont-dp1.png.vql.json
# KORU_VDISPLAY_PREFER_PHOTO_VQL=1
# KORU_VDISPLAY_PHOTO_VQL_REFRESH=auto
# KORU_VDISPLAY_USE_VQL_MOUSE_FOCUS=1
# KORU_VDISPLAY_CONTROL_FALLBACK=1

# Screencast / capture tuning
VDISPLAY_PIPEWIRE_CAPTURE_TIMEOUT_S=8
VDISPLAY_PIPEWIRE_FORCE_CAPS=0
VDISPLAY_SCREENCAST_GNOME_FALLBACK=1
VDISPLAY_PIPEWIRE_FRESH_FD=0
VDISPLAY_SCREENCAST_CURSOR=2
VDISPLAY_REPLAY_DELAY_S=0.25
VDISPLAY_EVENT_FORMAT=json
VDISPLAY_PROJECTIONS=1
VDISPLAY_IMG2NL=1
VDISPLAY_IMG2NL_LOCALE=pl
VDISPLAY_DESCRIBE_BACKEND=auto
VDISPLAY_VISION_PREVIEW=auto
VDISPLAY_SCREENCAST_LOCAL_START_COOLDOWN_S=60
VDISPLAY_SCREENCAST_RECOVERY_COOLDOWN_S=300
VDISPLAY_KEEPER_CAPTURE_TIMEOUT_S=
VDISPLAY_WEB_FRAME_CACHE_TTL_S=5.0
